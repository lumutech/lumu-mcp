# Lumu MCP Server configuration.
#
# Copy to `.env` for LOCAL DEVELOPMENT ONLY (it is git-ignored). In production /
# Claude Desktop, set these in the client's `env` block instead — do not ship a
# `.env` file. Every variable uses the LUMU_ prefix.

# --- Required -------------------------------------------------------------

# Lumu Defender API key. The server fails fast at startup if this is missing.
LUMU_DEFENDER_API_KEY=your-lumu-api-key

# --- Optional: Lumu API ---------------------------------------------------

# Base URL of the Lumu Defender REST API.
# LUMU_API_BASE_URL=https://defender.lumu.io/api

# Per-request HTTP timeout, in seconds (> 0).
# LUMU_REQUEST_TIMEOUT=30

# --- Optional: server identity / observability ----------------------------

# Server name reported to MCP clients.
# LUMU_NAME=lumu-mcp-server

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
# LUMU_LOG_LEVEL=INFO

# Enable SDK debug mode (true/false).
# LUMU_DEBUG=false

# --- Optional: transport (stdio is the default and only supported mode) ----
# The following apply only to HTTP transports (streamable-http / sse) and are
# NOT used by the default stdio deployment with Claude Desktop.

# LUMU_TRANSPORT=stdio
# LUMU_HOST=127.0.0.1
# LUMU_PORT=8000
# LUMU_STREAMABLE_HTTP_PATH=/mcp
# LUMU_JSON_RESPONSE=false
# LUMU_STATELESS_HTTP=false
# LUMU_MAX_REQUEST_BODY_SIZE=4194304
# JSON arrays, e.g. ["mcp.example.com"]
# LUMU_ALLOWED_HOSTS=[]
# LUMU_ALLOWED_ORIGINS=[]
